{
  "name": "15-ts-node-lab",
  "version": "1.0.0",
  "description": "nodejs typescript demos",
  "main": "server.js",
  "repository": "https://github.com/iproduct/fullstack-typescript-react.git",
  "author": "Trayan Iliev",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "server": "node --inspect=5858 -r ts-node/register ./src/server.ts",
    "tsc": "tsc -w",
    "start": "nodemon",
    "build": "tsc"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "indicative": "^7.4.4",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-plugin-import": "^2.32.0",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "exec": "ts-node ./src/server.ts",
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ]
  }
}
